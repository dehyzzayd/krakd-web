// Krakd platform data model.
// Design rules:
//  - Every tenant-owned row carries `dealershipId` (multi-tenant isolation).
//  - Money is stored in integer cents; never floats.
//  - Enums encode lifecycle state machines explicitly.
//  - Timestamps are UTC; per-dealer localization happens at the edge.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // native (local) + Vercel/Render Linux runtime
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime — point at Neon's POOLED host at scale
}

// ─────────────────────────────── Tenant & identity ───────────────────────────────

enum DealershipStatus {
  PENDING      // account created, subscription not yet active
  ACTIVE       // active subscription, full dashboard access
  PAST_DUE     // payment failed, grace period
  SUSPENDED    // access revoked
}

enum InventoryType {
  INDEPENDENT
  FRANCHISE
  GROUP
}

// The business vertical drives listing fields, filters, terminology and site templates.
enum Vertical {
  AUTOMOTIVE
  REAL_ESTATE
  RESTAURANT
  SERVICES
  RETAIL
  MEDICAL
  CONSTRUCTION
  GENERIC
}

model Dealership {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  legalName     String?
  inventoryType InventoryType    @default(INDEPENDENT)
  vertical      Vertical         @default(AUTOMOTIVE)
  status        DealershipStatus @default(PENDING)
  timezone      String           @default("America/Chicago")
  phone         String?
  email         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String           @default("US")
  hours         Json             @default("[]") // global business hours: [{ day, open, close }]
  brandColor    String?          // global brand accent (hex)
  logoUrl       String?          @db.Text // global logo (data URL or external)
  adConnections Json             @default("{}") // connected ad accounts: { facebook, instagram, google }
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  users         User[]
  subscription  Subscription?
  payments      Payment[]
  vehicles      Vehicle[]
  campaigns     Campaign[]
  leads         Lead[]
  activities    LeadActivity[]
  appointments  Appointment[]
  conversations AiConversation[]
  quotes        Quote[]
  metrics       DailyMetric[]
  aiSettings    AiSettings?
  website       Website?

  @@index([status])
  @@map("dealerships")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  PLATFORM_ADMIN // Krakd staff — cross-tenant oversight
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  dealershipId String     @db.Uuid
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole   @default(OWNER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens     RefreshToken[]
  assignedLeads     Lead[]         @relation("LeadAssignee")
  authoredActivity  LeadActivity[] @relation("ActivityActor")
  ownedAppointments Appointment[]  @relation("ApptAssignee")

  @@unique([email]) // email is a global login identifier
  @@index([dealershipId])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────── Billing ───────────────────────────────

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  dealershipId         String             @unique @db.Uuid
  dealership           Dealership         @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(INACTIVE)
  priceCents           Int                @default(14900) // $149/mo
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

enum PaymentType {
  SUBSCRIPTION
  CAMPAIGN_BUDGET
  MANAGEMENT_FEE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  dealershipId          String        @db.Uuid
  dealership            Dealership    @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  type                  PaymentType
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  currency              String        @default("usd")
  description           String?
  stripePaymentIntentId String?
  campaignId            String?       @db.Uuid
  createdAt             DateTime      @default(now())

  @@index([dealershipId, createdAt])
  @@map("payments")
}

// ─────────────────────────────── Inventory ───────────────────────────────

enum VehicleStatus {
  AVAILABLE
  RECON
  RESERVED
  WHOLESALE
  SOLD
}

model Vehicle {
  id            String        @id @default(uuid()) @db.Uuid
  dealershipId  String        @db.Uuid
  dealership    Dealership    @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  // generic listing fields (used by non-automotive verticals; auto still uses year/make/model)
  title         String?       // e.g. real-estate headline / product name
  subtitle      String?
  attributes    Json          @default("{}") // vertical-specific: { beds, baths, sqft, propertyType } etc.
  vin           String?
  stockNumber   String?
  year          Int?
  make          String?
  model         String?
  trim          String?
  bodyType      String?
  category      String?       // vehicle class: CAR | MOTORCYCLE | POWERSPORT | RV | TRAILER (deep specs live in attributes)
  mileage       Int           @default(0)
  status        VehicleStatus @default(RECON)
  priceCents    Int           @default(0)
  costCents     Int           @default(0)
  reconCents    Int           @default(0)
  packCents     Int           @default(0)
  exteriorColor String?
  interiorColor String?
  drivetrain    String?
  fuel          String?
  transmission  String?
  engine        String?
  photoUrls     Json          @default("[]")
  // vAuto-style market signals (cents)
  marketLowCents  Int?
  marketAvgCents  Int?
  marketHighCents Int?
  vdpViews      Int           @default(0)
  listedAt      DateTime?
  soldAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  leads         Lead[]
  appointments  Appointment[]

  @@unique([dealershipId, stockNumber])
  @@index([dealershipId, status])
  @@index([vin])
  @@map("vehicles")
}

// ─────────────────────────────── Advertising ───────────────────────────────

enum CampaignChannel {
  FACEBOOK
  INSTAGRAM
  GOOGLE
}

enum CampaignObjective {
  LEADS
  CALLS
  TRAFFIC
  MESSAGES
}

enum CampaignFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

model Campaign {
  id             String            @id @default(uuid()) @db.Uuid
  dealershipId   String            @db.Uuid
  dealership     Dealership        @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  name           String
  channel        CampaignChannel
  objective      CampaignObjective @default(LEADS)
  status         CampaignStatus    @default(DRAFT)
  frequency      CampaignFrequency @default(MONTHLY)
  // budget split — client picks budget, Krakd deducts 10% fee, 90% is media spend
  budgetCents    Int               @default(0)
  feeCents       Int               @default(0)
  netSpendCents  Int               @default(0)
  // targeting snapshot
  radiusMiles    Int               @default(25)
  ageMin         Int               @default(18)
  ageMax         Int               @default(65)
  gender         String            @default("all")
  smartTargeting Boolean           @default(true)
  promotedVehicleIds Json          @default("[]")
  // ad creative snapshot — the copy + image(s) that ship to the network
  format           String          @default("SINGLE_IMAGE") // SINGLE_IMAGE | CAROUSEL | SEARCH | VEHICLE
  primaryText      String?         @db.Text
  headline         String?
  description      String?
  cta              String          @default("LEARN_MORE")
  creativeImageUrl String?         @db.Text
  creativeImages   Json            @default("[]") // carousel image URLs
  startDate      DateTime?
  endDate        DateTime?
  // rolled-up performance
  impressions    Int               @default(0)
  clicks         Int               @default(0)
  leadCount      Int               @default(0)
  spentCents     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  leads Lead[]

  @@index([dealershipId, status])
  @@map("campaigns")
}

// ─────────────────────────────── CRM ───────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT
  SOLD
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum OwnerType {
  AI
  HUMAN
  UNASSIGNED
}

model Lead {
  id            String          @id @default(uuid()) @db.Uuid
  dealershipId  String          @db.Uuid
  dealership    Dealership      @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  campaignId    String?         @db.Uuid
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  vehicleId     String?         @db.Uuid
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  firstName     String
  lastName      String?
  emails        Json            @default("[]") // [{ value, type }]
  phones        Json            @default("[]")
  source        String?
  status        LeadStatus      @default(NEW)
  temperature   LeadTemperature @default(WARM)
  score         Int             @default(50)
  ownerType     OwnerType       @default(AI)
  assignedToId  String?         @db.Uuid
  assignedTo    User?           @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  hasTradeIn    Boolean         @default(false)
  financing     Boolean         @default(false)
  lastActivityAt DateTime       @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  activities    LeadActivity[]
  appointments  Appointment[]
  conversations AiConversation[]
  quotes        Quote[]

  @@index([dealershipId, status])
  @@index([dealershipId, lastActivityAt])
  @@map("leads")
}

enum ActivityType {
  NOTE
  CALL
  SMS
  EMAIL
  STATUS_CHANGE
  AI_MESSAGE
  APPOINTMENT_SET
  ASSIGNMENT
}

enum ActorType {
  AI
  USER
  SYSTEM
}

model LeadActivity {
  id           String       @id @default(uuid()) @db.Uuid
  dealershipId String       @db.Uuid
  dealership   Dealership   @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  leadId       String       @db.Uuid
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type         ActivityType
  actorType    ActorType    @default(USER)
  actorUserId  String?      @db.Uuid
  actorUser    User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  content      String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

enum AppointmentType {
  TEST_DRIVE
  DELIVERY
  PHONE
  SERVICE
  TRADE_APPRAISAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  dealershipId  String            @db.Uuid
  dealership    Dealership        @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  leadId        String            @db.Uuid
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vehicleId     String?           @db.Uuid
  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  type          AppointmentType   @default(TEST_DRIVE)
  status        AppointmentStatus @default(SCHEDULED)
  scheduledStart DateTime
  scheduledEnd  DateTime
  assignedToId  String?           @db.Uuid
  assignedTo    User?             @relation("ApptAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  location      String?
  notes         String?
  createdByAi   Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([dealershipId, scheduledStart])
  @@map("appointments")
}

// ─────────────────────────────── Krakd AI ───────────────────────────────

enum AiChannel {
  WEB
  SMS
  FBMP
  EMAIL
  VOICE
}

enum AiConversationStatus {
  ACTIVE
  HANDED_OFF
  CLOSED
}

model AiConversation {
  id           String               @id @default(uuid()) @db.Uuid
  dealershipId String               @db.Uuid
  dealership   Dealership           @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  leadId       String?              @db.Uuid
  lead         Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  channel      AiChannel            @default(WEB)
  status       AiConversationStatus @default(ACTIVE)
  externalRef  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  messages AiMessage[]

  @@index([dealershipId, status])
  @@map("ai_conversations")
}

enum AiRole {
  BUYER
  AI
  HUMAN
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiRole
  content        String
  toolCalls      Json?          // structured side-effects the agent invoked
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum NegotiationPosture {
  FLEXIBLE
  MOSTLY_FIRM
  NO_NEGOTIATION
}

enum BookingMode {
  DISABLED
  INTERNAL
  EXTERNAL
}

model AiSettings {
  id            String             @id @default(uuid()) @db.Uuid
  dealershipId  String             @unique @db.Uuid
  dealership    Dealership         @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  persona       String             @default("Warm & professional")
  negotiation   NegotiationPosture @default(MOSTLY_FIRM)
  bookingMode   BookingMode        @default(INTERNAL)
  tradeInEnabled Boolean           @default(true)
  financeEnabled Boolean           @default(true)
  afterHours    Boolean            @default(true)
  welcomeMessage String            @default("Hey! Looking for something specific? I can check what's on the lot and set up a time to see it.")
  houseRules    String?
  inventoryUrl  String?
  creditAppUrl  String?
  appointmentUrl String?
  testDriveUrl  String?
  aiPhone       String?            // Krakd-provisioned line
  forwardPhone  String?
  languages     Json               @default("[\"English\"]")
  channels      Json               @default("{\"website\":true,\"fbmp\":true,\"sms\":true,\"email\":false}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("ai_settings")
}

// ─────────────────────────────── Analytics ───────────────────────────────

model DailyMetric {
  id             String     @id @default(uuid()) @db.Uuid
  dealershipId   String     @db.Uuid
  dealership     Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  date           DateTime   @db.Date
  newLeads       Int        @default(0)
  appointments   Int        @default(0)
  vehiclesSold   Int        @default(0)
  adSpendCents   Int        @default(0)
  grossCents     Int        @default(0)
  aiConversations Int       @default(0)
  aiLeadsCaptured Int       @default(0)

  @@unique([dealershipId, date])
  @@map("daily_metrics")
}

// ─────────────────────────────── Dealer Website module ───────────────────────────────

enum WebsiteTemplate {
  MODERN         // bright bento, rounded (CarMax/Carvana)
  INVENTORY_FIRST // black industrial + ticker, inventory-forward
  PREMIUM        // ivory serif editorial (luxury)
  CLASSIC        // corporate franchise, utility bar, blue/boxy
  SPORT          // charcoal performance/exotic, angular
  MINIMAL        // airy Scandinavian/EV, hairlines + whitespace
  AURORA         // dark navy + vivid accent, lowercase display, circular badge (Northline Aurora)
  QUIET          // warm off-white + teal, utility bar, calm/premium (Northline)
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
}

enum DomainStatus {
  NOT_CONNECTED   // no domain selected
  PENDING_DNS     // waiting for DNS records
  PROVISIONING    // SSL + routing setup
  LIVE            // domain is active
  ACTION_REQUIRED // connection failed
}

model Website {
  id           String          @id @default(uuid()) @db.Uuid
  dealershipId String          @unique @db.Uuid
  dealership   Dealership      @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  template     WebsiteTemplate @default(MODERN)
  status       WebsiteStatus   @default(DRAFT)
  slug         String          @unique // public preview URL: /site/{slug}

  // branding + homepage content (controlled fields — not a page builder)
  logoUrl      String?         @db.Text // uploaded asset (data URL) or external URL
  heroImageUrl String?         @db.Text // optional hero background asset
  primaryColor String          @default("#2b6ba4")
  headerStyle  String          @default("auto") // auto | light | dark | accent
  headline     String          @default("Find your next vehicle.")
  intro        String          @default("Browse our latest inventory — updated daily.")
  ctaLabel     String          @default("Browse inventory")

  // richer multi-page content
  aboutText     String?        @db.Text
  financingText String?        @db.Text
  tradeInText   String?        @db.Text
  whyUs         Json           @default("[]") // [{ title, body }]
  staff         Json           @default("[]") // [{ name, role, photoUrl }]
  reviews       Json           @default("[]") // [{ name, rating, body }]
  pages         Json           @default("[]") // custom pages: [{ id, slug, title, body, inNav, showSidebar }]
  nav           Json           @default("[]") // curated navbar: [{ id, label, type, value, visible }] (empty = defaults)
  sidebar       Json           @default("[]") // shared page sidebar blocks: [{ id, type, title, body }] (empty = defaults)
  vdpButtonLabel String?       // custom CTA button shown on every vehicle detail page
  vdpButtonUrl   String?

  // dealership contact shown on the site
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  zip          String?
  hours        Json            @default("[]")  // [{ day, open, close }]
  socials      Json            @default("{}")   // { facebook, instagram, ... }
  sections     Json            @default("{}")   // { trustBar, shopByType, financing, reviews, whyUs, about } — missing = shown

  // domain
  domain         String?
  domainProvider String?       // "existing" | "krakd"
  domainStatus   DomainStatus  @default(NOT_CONNECTED)
  domainPriceCents Int?        // shown/confirmed price when purchased through Krakd
  domainRenewsAt DateTime?

  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("websites")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  dealershipId  String      @db.Uuid
  dealership    Dealership  @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  leadId        String?     @db.Uuid
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  number        String                          // human quote no. e.g. Q-1001
  clientName    String
  clientEmail   String?
  clientPhone   String?
  projectTitle  String?
  status        QuoteStatus @default(DRAFT)
  notes         String?     @db.Text
  taxRate       Float       @default(0)          // percent
  subtotalCents Int         @default(0)
  taxCents      Int         @default(0)
  totalCents    Int         @default(0)
  validUntil    DateTime?
  publicToken   String      @unique              // unguessable id for the client-facing accept link
  sentAt        DateTime?
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         QuoteLineItem[]

  @@index([dealershipId, status])
  @@map("quotes")
}

model QuoteLineItem {
  id          String @id @default(uuid()) @db.Uuid
  quoteId     String @db.Uuid
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float  @default(1)
  unitCents   Int    @default(0)
  amountCents Int    @default(0)
  sortOrder   Int    @default(0)

  @@map("quote_line_items")
}

/// Cross-tenant audit trail for privileged platform-admin actions (impersonation, etc.).
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid   // the admin who acted
  actorEmail   String
  action       String                // e.g. IMPERSONATE
  targetType   String?               // e.g. DEALERSHIP
  targetId     String?  @db.Uuid
  dealershipId String?  @db.Uuid     // dealership the action touched
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([action, createdAt])
  @@index([dealershipId])
  @@map("audit_logs")
}
